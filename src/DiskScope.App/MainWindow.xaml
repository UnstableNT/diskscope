<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DiskScope.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DiskScope.App.ViewModels"
    Title="DiskScope">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Own title bar: the content extends into the window frame so Mica and the theme apply there too. -->
    <Grid x:Name="AppTitleBar" Height="36" Padding="16,0,0,0" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Width="16" Height="16" VerticalAlignment="Center" Source="ms-appx:///Assets/DiskScope.png" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="DiskScope" />
    </Grid>

    <!-- Header: drive selection, temperature, actions (SPEC 4.1). -->
    <Grid Grid.Row="1" Padding="16,4,16,8" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ComboBox
          x:Name="DriveSelector"
          Width="460"
          VerticalAlignment="Center"
          IsEnabled="{x:Bind ViewModel.Selection.IsIdle, Mode=OneWay}"
          ItemsSource="{x:Bind ViewModel.Drives}"
          PlaceholderText="Laufwerk wählen"
          SelectionChanged="OnDriveSelectionChanged"
          ToolTipService.ToolTip="Laufwerk">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DriveItem">
            <TextBlock Text="{x:Bind Title}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Border
          x:Name="TemperatureBadge"
          Grid.Column="1"
          Padding="12,6"
          VerticalAlignment="Center"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="16"
          ToolTipService.ToolTip="{x:Bind ViewModel.TemperatureDetail, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <FontIcon x:Name="TemperatureIcon" FontSize="14" Glyph="&#xE9CA;" />
          <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.TemperatureText, Mode=OneWay}" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
        <Button AutomationProperties.Name="Ergebnisse kopieren" Click="OnCopyClick" ToolTipService.ToolTip="Ergebnisse kopieren">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon FontSize="14" Glyph="&#xE8C8;" />
            <TextBlock Text="Kopieren" />
          </StackPanel>
        </Button>
        <Button AutomationProperties.Name="Als JSON exportieren" Click="OnJsonClick" ToolTipService.ToolTip="Ergebnisse als JSON exportieren">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon FontSize="14" Glyph="&#xE74E;" />
            <TextBlock Text="JSON" />
          </StackPanel>
        </Button>
        <Button AutomationProperties.Name="Screenshot speichern" Click="OnScreenshotClick" ToolTipService.ToolTip="Screenshot speichern">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon FontSize="14" Glyph="&#xE722;" />
            <TextBlock Text="Screenshot" />
          </StackPanel>
        </Button>
        <Button AutomationProperties.Name="Laufwerksstatus" Click="OnStatusClick" ToolTipService.ToolTip="Statusübersicht aller Laufwerke">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon FontSize="14" Glyph="&#xE9D9;" />
            <TextBlock Text="Übersicht" />
          </StackPanel>
        </Button>
        <Button AutomationProperties.Name="Über DiskScope" Click="OnAboutClick" ToolTipService.ToolTip="Über DiskScope">
          <FontIcon FontSize="14" Glyph="&#xE946;" />
        </Button>
        <Button AutomationProperties.Name="Einstellungen" Click="OnSettingsClick" ToolTipService.ToolTip="Einstellungen">
          <FontIcon FontSize="14" Glyph="&#xE713;" />
        </Button>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="2" Padding="16,0" Spacing="4">
      <InfoBar
          IsClosable="True"
          IsOpen="{x:Bind ViewModel.ShowElevationHint}"
          Message="Benchmark, Fehlerscan und Zufallszugriff brauchen Rohzugriff auf das Laufwerk; S.M.A.R.T.-Schwellwerte sind nur mit Adminrechten lesbar."
          Severity="Warning"
          Title="Ohne Administratorrechte">
        <InfoBar.ActionButton>
          <Button Command="{x:Bind ViewModel.RestartElevatedCommand}" Content="Als Administrator neu starten" />
        </InfoBar.ActionButton>
      </InfoBar>
      <InfoBar x:Name="MessageBar" IsClosable="True" Severity="Informational" />
    </StackPanel>

    <NavigationView
        x:Name="Navigation"
        Grid.Row="3"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        PaneDisplayMode="Top"
        SelectionChanged="OnNavigationSelectionChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Benchmark" Tag="Benchmark" />
        <NavigationViewItem Content="Info" Tag="Info" />
        <NavigationViewItem Content="Gesundheit" Tag="Health" />
        <NavigationViewItem Content="Fehlerscan" Tag="Scan" />
        <NavigationViewItem Content="Ordnernutzung" Tag="Folders" />
        <NavigationViewItem Content="Löschen" Tag="Erase" />
        <NavigationViewItem Content="Datei-Benchmark" Tag="FileBench" />
        <NavigationViewItem Content="Monitor" Tag="Monitor" />
        <NavigationViewItem Content="Zufallszugriff" Tag="Random" />
        <NavigationViewItem Content="Zusatztests" Tag="Extra" />
      </NavigationView.MenuItems>
      <ContentControl
          x:Name="TabHost"
          HorizontalContentAlignment="Stretch"
          VerticalContentAlignment="Stretch" />
    </NavigationView>
  </Grid>
</Window>

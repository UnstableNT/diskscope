<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DiskScope.App.Views.FolderUsageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DiskScope.App.ViewModels">
  <Grid Padding="16,8,0,16" ColumnSpacing="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid RowSpacing="4">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Padding="12,4" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="110" />
          <ColumnDefinition Width="220" />
          <ColumnDefinition Width="110" />
        </Grid.ColumnDefinitions>
        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Ordner" />
        <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Größe" />
        <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Anteil" />
        <TextBlock Grid.Column="3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Dateien" />
      </Grid>

      <TreeView Grid.Row="1" Expanding="OnExpanding" ItemsSource="{x:Bind ViewModel.Roots}" SelectionMode="None">
        <TreeView.ItemTemplate>
          <DataTemplate x:DataType="vm:FolderItem">
            <TreeViewItem HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}" ItemsSource="{x:Bind Children}">
              <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                  <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind Size}" />
                <Grid Grid.Column="2" ColumnSpacing="8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="56" />
                  </Grid.ColumnDefinitions>
                  <ProgressBar VerticalAlignment="Center" Maximum="100" Value="{x:Bind Share}" />
                  <TextBlock Grid.Column="1" Text="{x:Bind ShareText}" />
                </Grid>
                <TextBlock Grid.Column="3" Text="{x:Bind Files}" />
              </Grid>
            </TreeViewItem>
          </DataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
    </Grid>

    <ScrollViewer Grid.Column="1">
      <StackPanel Style="{StaticResource SidebarPanelStyle}">
        <Button
            HorizontalAlignment="Stretch"
            Command="{x:Bind ViewModel.StartStopCommand}"
            Content="{x:Bind ViewModel.StartStopText, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.CanStartStop, Mode=OneWay}"
            Style="{StaticResource AccentButtonStyle}" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />

        <TextBlock Style="{StaticResource SidebarHeaderStyle}" Text="Optionen" />
        <ComboBox HorizontalAlignment="Stretch" Header="Volume" IsEnabled="{x:Bind ViewModel.OptionsEnabled, Mode=OneWay}" ItemsSource="{x:Bind ViewModel.Targets}" PlaceholderText="Kein Volume mit Laufwerksbuchstaben" SelectedItem="{x:Bind ViewModel.SelectedTarget, Mode=TwoWay}" />
        <Button HorizontalAlignment="Stretch" Click="OnPickFolder" Content="Anderen Ordner wählen …" IsEnabled="{x:Bind ViewModel.OptionsEnabled, Mode=OneWay}" />
        <ComboBox HorizontalAlignment="Stretch" Header="Sortierung" SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}">
          <x:String>Nach Größe</x:String>
          <x:String>Nach Name</x:String>
          <x:String>Nach Dateianzahl</x:String>
        </ComboBox>
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Symbolische Verknüpfungen und Junctions werden nicht verfolgt, Ordner ohne Zugriff übersprungen." TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

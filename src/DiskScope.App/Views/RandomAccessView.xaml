<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DiskScope.App.Views.RandomAccessView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DiskScope.App.Controls"
    xmlns:scottplot="using:ScottPlot.WinUI"
    xmlns:vm="using:DiskScope.App.ViewModels">
  <Grid Padding="16,8,0,16" ColumnSpacing="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Background="{StaticResource PlotBackgroundBrush}" CornerRadius="8">
        <scottplot:WinUIPlot x:Name="Chart" />
      </Border>

      <!-- Table per transfer size (SPEC 4.10) -->
      <StackPanel Grid.Row="1" Spacing="2">
        <Grid Padding="8,4" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Größe" />
          <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Operationen/s" />
          <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Mittlere Zugriffszeit" />
          <TextBlock Grid.Column="3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Maximale Zugriffszeit" />
          <TextBlock Grid.Column="4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Geschwindigkeit" />
        </Grid>
        <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RandomRow">
              <Grid Padding="8,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="140" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Ellipse Width="10" Height="10" Fill="{x:Bind vm:InfoViewBrushes.Hex(Color)}" />
                  <TextBlock Text="{x:Bind Size}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind Iops}" />
                <TextBlock Grid.Column="2" Text="{x:Bind AverageMs}" />
                <TextBlock Grid.Column="3" Text="{x:Bind MaximumMs}" />
                <TextBlock Grid.Column="4" Text="{x:Bind Speed}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Column="1">
      <StackPanel Style="{StaticResource SidebarPanelStyle}">
        <Button
            HorizontalAlignment="Stretch"
            Command="{x:Bind ViewModel.StartStopCommand}"
            Content="{x:Bind ViewModel.StartStopText, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.CanStartStop, Mode=OneWay}"
            Style="{StaticResource AccentButtonStyle}" />
        <ProgressBar Maximum="100" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />

        <TextBlock Style="{StaticResource SidebarHeaderStyle}" Text="Transfergrößen" />
        <CheckBox Content="512 B" IsChecked="{x:Bind ViewModel.Use512, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.OptionsEnabled, Mode=OneWay}" />
        <CheckBox Content="4 KiB" IsChecked="{x:Bind ViewModel.Use4K, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.OptionsEnabled, Mode=OneWay}" />
        <CheckBox Content="64 KiB" IsChecked="{x:Bind ViewModel.Use64K, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.OptionsEnabled, Mode=OneWay}" />
        <CheckBox Content="1 MiB" IsChecked="{x:Bind ViewModel.Use1M, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.OptionsEnabled, Mode=OneWay}" />
        <CheckBox Content="Zufällig (gemischt)" IsChecked="{x:Bind ViewModel.UseMixed, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.OptionsEnabled, Mode=OneWay}" />

        <TextBlock Style="{StaticResource SidebarHeaderStyle}" Text="Optionen" />
        <CheckBox Content="4-KiB-Ausrichtung" IsChecked="{x:Bind ViewModel.Align4K, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.OptionsEnabled, Mode=OneWay}" />
        <CheckBox Content="Schreiben (löscht Daten!)" IsChecked="{x:Bind ViewModel.WriteMode, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanWrite}" ToolTipService.ToolTip="Schreibend messen; nur auf Laufwerken ohne Systempartition, mit Bestätigung" />
        <CheckBox Content="Volumes vorher aushängen" IsChecked="{x:Bind ViewModel.DismountVolumes, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.WriteMode, Mode=OneWay}" />
        <NumberBox
            Header="Messdauer je Größe (s)"
            IsEnabled="{x:Bind ViewModel.OptionsEnabled, Mode=OneWay}"
            Maximum="60"
            Minimum="1"
            SpinButtonPlacementMode="Compact"
            Value="{x:Bind ViewModel.DurationSeconds, Mode=TwoWay}" />
        <controls:RangeOption ViewModel="{x:Bind ViewModel}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

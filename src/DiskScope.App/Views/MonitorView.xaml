<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DiskScope.App.Views.MonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DiskScope.App.Controls"
    xmlns:scottplot="using:ScottPlot.WinUI"
    xmlns:vm="using:DiskScope.App.ViewModels">
  <Grid Padding="16,8,0,16" ColumnSpacing="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid RowSpacing="8">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- Rate over time (SPEC 4.9 top) -->
      <Border Background="{StaticResource PlotBackgroundBrush}" CornerRadius="8">
        <scottplot:WinUIPlot x:Name="RateChart" />
      </Border>

      <!-- Sub tabs -->
      <SelectorBar x:Name="SubTabs" Grid.Row="1" SelectionChanged="OnSubTabChanged">
        <SelectorBarItem IsSelected="True" Tag="Sizes" Text="Blockgröße" />
        <SelectorBarItem Tag="Position" Text="Position" />
        <SelectorBarItem Tag="Processes" Text="Programme" />
        <SelectorBarItem Tag="Statistics" Text="Statistik" />
      </SelectorBar>

      <Grid Grid.Row="2">
        <Grid x:Name="SizesPanel" RowSpacing="4">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ToggleSwitch x:Name="SizeByBytes" OffContent="Anzahl I/O" OnContent="Datenmenge" Toggled="OnSizeModeToggled" />
          <Border Grid.Row="1" Background="{StaticResource PlotBackgroundBrush}" CornerRadius="8">
            <scottplot:WinUIPlot x:Name="SizeChart" />
          </Border>
        </Grid>

        <Border x:Name="PositionPanel" Background="{StaticResource PlotBackgroundBrush}" CornerRadius="8" Visibility="Collapsed">
          <scottplot:WinUIPlot x:Name="PositionChart" />
        </Border>

        <Grid x:Name="ProcessesPanel" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Padding="12,4" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="70" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Programm" />
            <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="PID" />
            <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Gelesen" />
            <TextBlock Grid.Column="3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Geschrieben" />
            <TextBlock Grid.Column="4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="I/O lesen" />
            <TextBlock Grid.Column="5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="I/O schreiben" />
          </Grid>
          <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Processes}" SelectionMode="None">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="vm:ProcessRow">
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="70" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Pid}" />
                  <TextBlock Grid.Column="2" Text="{x:Bind Read}" />
                  <TextBlock Grid.Column="3" Text="{x:Bind Write}" />
                  <TextBlock Grid.Column="4" Text="{x:Bind ReadCount}" />
                  <TextBlock Grid.Column="5" Text="{x:Bind WriteCount}" />
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>

        <StackPanel x:Name="StatisticsPanel" Spacing="2" Visibility="Collapsed">
          <Grid Padding="12,4" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Lesen" />
            <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Schreiben" />
          </Grid>
          <ItemsControl ItemsSource="{x:Bind ViewModel.Statistics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:StatisticRow">
                <Grid Padding="12,4" ColumnSpacing="12">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Label}" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Read}" />
                  <TextBlock Grid.Column="2" Text="{x:Bind Write}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Grid>
    </Grid>

    <ScrollViewer Grid.Column="1">
      <StackPanel Style="{StaticResource SidebarPanelStyle}">
        <Button
            HorizontalAlignment="Stretch"
            Command="{x:Bind ViewModel.StartStopCommand}"
            Content="{x:Bind ViewModel.StartStopText, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.CanStartStop, Mode=OneWay}"
            Style="{StaticResource AccentButtonStyle}" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
        <controls:MetricTile Label="Verstrichene Zeit" Value="{x:Bind ViewModel.Elapsed, Mode=OneWay}" />

        <TextBlock Style="{StaticResource SidebarHeaderStyle}" Text="Lesen" />
        <Grid ColumnSpacing="8" RowSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <controls:MetricTile Label="Aktuell" Value="{x:Bind ViewModel.ReadCurrent, Mode=OneWay}" />
          <controls:MetricTile Grid.Column="1" Label="Maximum" Value="{x:Bind ViewModel.ReadMaximum, Mode=OneWay}" />
          <controls:MetricTile Grid.Row="1" Label="Anzahl I/O" Value="{x:Bind ViewModel.ReadCount, Mode=OneWay}" />
          <controls:MetricTile Grid.Row="1" Grid.Column="1" Label="Gesamt" Value="{x:Bind ViewModel.ReadTotal, Mode=OneWay}" />
        </Grid>

        <TextBlock Style="{StaticResource SidebarHeaderStyle}" Text="Schreiben" />
        <Grid ColumnSpacing="8" RowSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <controls:MetricTile Label="Aktuell" Value="{x:Bind ViewModel.WriteCurrent, Mode=OneWay}" />
          <controls:MetricTile Grid.Column="1" Label="Maximum" Value="{x:Bind ViewModel.WriteMaximum, Mode=OneWay}" />
          <controls:MetricTile Grid.Row="1" Label="Anzahl I/O" Value="{x:Bind ViewModel.WriteCount, Mode=OneWay}" />
          <controls:MetricTile Grid.Row="1" Grid.Column="1" Label="Gesamt" Value="{x:Bind ViewModel.WriteTotal, Mode=OneWay}" />
        </Grid>

        <NumberBox Header="Zeitfenster (Minuten)" IsEnabled="{x:Bind ViewModel.OptionsEnabled, Mode=OneWay}" Maximum="240" Minimum="1" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.WindowMinutes, Mode=TwoWay}" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DiskScope.App.Views.BenchmarkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DiskScope.App.Controls"
    xmlns:scottplot="using:ScottPlot.WinUI">
  <!-- Standard test tab: chart left, sidebar with start/stop, options and key figures right (SPEC 4.1). -->
  <Grid Padding="16,8,0,16" ColumnSpacing="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Border Background="{StaticResource PlotBackgroundBrush}" CornerRadius="8">
      <scottplot:WinUIPlot x:Name="Chart" />
    </Border>

    <ScrollViewer Grid.Column="1">
      <StackPanel Style="{StaticResource SidebarPanelStyle}">
        <Button
            HorizontalAlignment="Stretch"
            Command="{x:Bind ViewModel.StartStopCommand}"
            Content="{x:Bind ViewModel.StartStopText, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.CanStartStop, Mode=OneWay}"
            Style="{StaticResource AccentButtonStyle}" />
        <ProgressBar Maximum="100" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />

        <TextBlock Style="{StaticResource SidebarHeaderStyle}" Text="Optionen" />
        <ComboBox
            HorizontalAlignment="Stretch"
            Header="Blockgröße"
            IsEnabled="{x:Bind ViewModel.OptionsEnabled, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.BlockSizes}"
            SelectedIndex="{x:Bind ViewModel.SelectedBlockSize, Mode=TwoWay}" />
        <CheckBox Content="Transferrate" IsChecked="{x:Bind ViewModel.MeasureTransfer, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.OptionsEnabled, Mode=OneWay}" />
        <CheckBox Content="Zugriffszeit" IsChecked="{x:Bind ViewModel.MeasureAccess, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.OptionsEnabled, Mode=OneWay}" />
        <CheckBox Content="Burst-Rate" IsChecked="{x:Bind ViewModel.MeasureBurst, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.OptionsEnabled, Mode=OneWay}" />
        <CheckBox Content="Schreiben (löscht Daten!)" IsChecked="{x:Bind ViewModel.WriteMode, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanWrite}" ToolTipService.ToolTip="Schreibend messen; nur auf Laufwerken ohne Systempartition, mit Bestätigung" />
        <CheckBox Content="Volumes vorher aushängen" IsChecked="{x:Bind ViewModel.DismountVolumes, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.WriteMode, Mode=OneWay}" />
        <controls:RangeOption ViewModel="{x:Bind ViewModel}" />

        <TextBlock Style="{StaticResource SidebarHeaderStyle}" Text="Ergebnisse" />
        <Grid ColumnSpacing="8" RowSpacing="8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <controls:MetricTile Label="Minimum" Value="{x:Bind ViewModel.Minimum, Mode=OneWay}" />
          <controls:MetricTile Grid.Column="1" Label="Maximum" Value="{x:Bind ViewModel.Maximum, Mode=OneWay}" />
          <controls:MetricTile Grid.Row="1" Label="Durchschnitt" Value="{x:Bind ViewModel.Average, Mode=OneWay}" />
          <controls:MetricTile Grid.Row="1" Grid.Column="1" Label="Zugriffszeit" Value="{x:Bind ViewModel.AccessTime, Mode=OneWay}" />
          <controls:MetricTile Grid.Row="2" Label="Burst-Rate" Value="{x:Bind ViewModel.Burst, Mode=OneWay}" />
          <controls:MetricTile Grid.Row="2" Grid.Column="1" Label="CPU-Last" Value="{x:Bind ViewModel.Cpu, Mode=OneWay}" />
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>

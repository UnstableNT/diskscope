<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DiskScope.App.Views.HealthView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DiskScope.App.ViewModels">
  <Grid Padding="16" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Padding="12,6" ColumnSpacing="12" Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="44" />
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="1.5*" />
        <ColumnDefinition Width="56" />
        <ColumnDefinition Width="56" />
        <ColumnDefinition Width="56" />
        <ColumnDefinition Width="1.5*" />
        <ColumnDefinition Width="80" />
      </Grid.ColumnDefinitions>
      <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="ID" />
      <TextBlock Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Name" />
      <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Wert" />
      <TextBlock Grid.Column="3" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Aktuell" />
      <TextBlock Grid.Column="4" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Schl." />
      <TextBlock Grid.Column="5" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Schw." />
      <TextBlock Grid.Column="6" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Rohdaten" />
      <TextBlock Grid.Column="7" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Status" />
    </Grid>

    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Rows}" SelectionMode="None">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="MinHeight" Value="32" />
          <Setter Property="Padding" Value="12,0" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="vm:SmartRow">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="1.5*" />
              <ColumnDefinition Width="56" />
              <ColumnDefinition Width="56" />
              <ColumnDefinition Width="56" />
              <ColumnDefinition Width="1.5*" />
              <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <TextBlock FontFamily="Consolas" Text="{x:Bind Id}" />
            <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Value}" />
            <TextBlock Grid.Column="3" Text="{x:Bind Current}" />
            <TextBlock Grid.Column="4" Text="{x:Bind Worst}" />
            <TextBlock Grid.Column="5" Text="{x:Bind Threshold}" />
            <TextBlock Grid.Column="6" FontFamily="Consolas" Text="{x:Bind Raw}" />
            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6">
              <Ellipse Width="10" Height="10" Fill="{x:Bind vm:InfoViewBrushes.Health(Status)}" />
              <TextBlock Text="{x:Bind StatusText}" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>

    <!-- Footer: overall status, countdown to the next refresh, actions (SPEC 4.3). -->
    <Grid Grid.Row="2" Padding="12" ColumnSpacing="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Ellipse Width="18" Height="18" Fill="{x:Bind vm:InfoViewBrushes.Health(ViewModel.Overall), Mode=OneWay}" />
        <StackPanel>
          <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.OverallText, Mode=OneWay}" />
          <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.SourceText, Mode=OneWay}" />
        </StackPanel>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
        <ProgressBar Maximum="1" Value="{x:Bind ViewModel.CountdownFraction, Mode=OneWay}" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.CountdownText, Mode=OneWay}" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemFillColorCautionBrush}" Text="{x:Bind ViewModel.Hint, Mode=OneWay}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.SelfTestText, Mode=OneWay}" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <Button Command="{x:Bind ViewModel.RefreshCommand}" Content="Aktualisieren" Style="{StaticResource AccentButtonStyle}" />
        <DropDownButton Content="Selbsttest" IsEnabled="{x:Bind ViewModel.SelfTestAvailable, Mode=OneWay}">
          <DropDownButton.Flyout>
            <MenuFlyout Placement="TopEdgeAlignedRight">
              <MenuFlyoutItem Command="{x:Bind ViewModel.StartQuickSelfTestCommand}" Text="Kurzer Selbsttest" />
              <MenuFlyoutItem Command="{x:Bind ViewModel.StartExtendedSelfTestCommand}" Text="Erweiterter Selbsttest" />
              <MenuFlyoutSeparator />
              <MenuFlyoutItem Command="{x:Bind ViewModel.AbortSelfTestCommand}" Text="Laufenden Selbsttest abbrechen" />
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>
        <Button Click="OnHistoryClick" Content="Protokoll" ToolTipService.ToolTip="Verlauf gespeicherter Abfragen mit Änderungen je Attribut" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DiskScope.App.StatusWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:DiskScope.App.Services"
    xmlns:vm="using:DiskScope.App.ViewModels"
    Title="DiskScope – Laufwerksstatus">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <!-- Compact overview of all drives (SPEC 4.13) -->
  <Grid Padding="16,0,16,16" RowSpacing="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid x:Name="AppTitleBar" Height="36" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Image Width="16" Height="16" VerticalAlignment="Center" Source="ms-appx:///Assets/DiskScope.png" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Text="Laufwerksstatus" />
    </Grid>
    <ItemsControl Grid.Row="1" ItemsSource="{x:Bind Monitor.Rows}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="services:DriveStatusRow">
          <Grid Margin="0,0,0,8" Padding="12,8" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Ellipse Width="14" Height="14" Fill="{x:Bind vm:InfoViewBrushes.Health(Status), Mode=OneWay}" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind StatusText, Mode=OneWay}" />
            </StackPanel>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Temperature, Mode=OneWay}" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Grid Grid.Row="2" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button Click="OnRefreshClick" Content="Aktualisieren" />
      <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Bei Statuswechsel erscheint eine Windows-Benachrichtigung." TextWrapping="Wrap" />
    </Grid>
  </Grid>
</Window>

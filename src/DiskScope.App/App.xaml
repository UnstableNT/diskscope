<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DiskScope.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <!-- DiskScope palette: status colors and the dark plot area (SPEC 6). -->
      <SolidColorBrush x:Key="StatusOkBrush" Color="#3FB950" />
      <SolidColorBrush x:Key="StatusWarningBrush" Color="#D29922" />
      <SolidColorBrush x:Key="StatusErrorBrush" Color="#F85149" />
      <SolidColorBrush x:Key="StatusUnknownBrush" Color="#8B949E" />
      <SolidColorBrush x:Key="PlotBackgroundBrush" Color="#161B22" />

      <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="0,8,0,2" />
      </Style>

      <Style x:Key="SidebarPanelStyle" TargetType="StackPanel">
        <Setter Property="Spacing" Value="6" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Width" Value="300" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>

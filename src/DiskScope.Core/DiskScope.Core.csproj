<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DiskScope.Core</RootNamespace>
    <!-- unsafe code is only allowed in the Native folder (enforced by review, see SPEC 2). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Native\NativeMethods.txt" />
    <AdditionalFiles Include="Native\NativeMethods.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\smart-attributes.json" LogicalName="DiskScope.Core.Data.smart-attributes.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DiskScope.Core.Tests" />
  </ItemGroup>

</Project>
